# Copy to .env next to docker-compose.yml and replace the token.
PUBLISH_TOKEN=replace-with-a-long-random-token
SITE_BASE_URL=http://127.0.0.1:8080

PUBLISH_ENABLED=true
MAX_REPORT_BYTES=104857600
MAX_REPORT_FILES=2000
MAX_REPORTS=50
PUBLISH_RATE_LIMIT=5/min
PUBLIC_RATE_LIMIT=120/min/IP
PREVIOUS_VERSION_TTL_H=24
AUDIO_CACHE_MAX_MB=200
DB_BUSY_TIMEOUT_MS=5000
LOG_LEVEL=info
SENTRY_DSN=

# Optional: use Aliyun OSS instead of the local object-store fallback.
# Keep the real keys in .env (gitignored) or in the K8s Secret, never here.
# OSS_BUCKET=situlearn-reports
# OSS_ENDPOINT=oss-<region>-internal.aliyuncs.com
# OSS_PREFIX=situlearn/
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
