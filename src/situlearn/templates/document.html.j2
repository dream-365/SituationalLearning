<!doctype html>
<html lang="{{ document.meta.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; media-src 'self'; img-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
{%- if pwa_manifest_url %}
<link rel="manifest" href="{{ pwa_manifest_url }}">
{%- endif %}
<title>{{ document.meta.title }} · 情景学习</title>
<style>
  :root {
    --bg: #f7f4ee;
    --paper: #fffdf9;
    --ink: #211f1b;
    --muted: #6d675d;
    --line: #ddd5c8;
    --accent: #8a3b2f;
    --accent-soft: #f0e3dc;
    --gold: #b08a3e;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
    line-height: 1.7;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 24px 72px; }
  header.hero { padding: 56px 0 32px; border-bottom: 1px solid var(--line); margin-bottom: 32px; }
  .eyebrow { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); margin: 0 0 12px; }
  h1, h2, h3 { font-family: Georgia, "Songti SC", "Noto Serif SC", serif; font-weight: 600; }
  h1 { font-size: clamp(30px, 4.5vw, 50px); line-height: 1.15; margin: 0 0 14px; }
  h2 { font-size: 24px; margin: 0; }
  h3 { font-size: 21px; margin: 0; }
  .subtitle { font-size: 18px; color: var(--muted); margin: 0 0 14px; max-width: 760px; }
  .description { background: var(--paper); border-left: 3px solid var(--gold); padding: 16px 20px; margin: 20px 0 0; }
  .meta { font-size: 13px; color: var(--muted); }
  .narrative-intro { margin: 0 0 14px; }
  .section-lead { color: var(--muted); margin: 6px 0 0; }
  .chapter { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 22px 24px; margin: 18px 0; scroll-margin-top: 24px; }
  .chapter-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .chapter-head .time { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .chapter-head .no-audio { font-size: 12px; color: var(--muted); }
  .chapter-head .play { margin-left: auto; }
  button { font: inherit; border: 1px solid var(--accent); background: var(--accent); color: #fff; border-radius: 999px; padding: 6px 14px; cursor: pointer; }
  button:disabled { opacity: .45; cursor: not-allowed; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 0; }
  .chip { font-size: 12px; background: var(--accent-soft); color: var(--accent); border-radius: 999px; padding: 3px 10px; text-decoration: none; }
  .group { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }
  .group.layout-row { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
  .group.layout-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .text { margin: 0; }
  .text-heading { font-family: Georgia, "Songti SC", serif; font-size: 20px; font-weight: 600; }
  .text-caption { color: var(--muted); font-size: 13px; }
  .text-quote { border-left: 3px solid var(--gold); padding-left: 14px; color: var(--muted); }
  figure { margin: 0; }
  img { max-width: 100%; border-radius: 10px; display: block; }
  audio { width: 100%; margin: 6px 0; }
  .script { color: var(--muted); font-size: 14px; }
  details.script summary { cursor: pointer; color: var(--accent); font-size: 14px; }
  .missing { border: 1px dashed var(--line); border-radius: 10px; padding: 18px; color: var(--muted); font-size: 14px; }
  .role-vocabulary { background: transparent; border: 0; padding: 0; }
  .role-vocabulary .chapter-head { margin-bottom: 14px; }
  .vocab-count { margin-left: auto; font-size: 12px; color: var(--muted); }
  .vocab-toolbar { display: flex; gap: 12px; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; margin: 14px 0 18px; position: sticky; top: 0; z-index: 8; background: var(--bg); padding: 8px 0; }
  .vocab-categories { display: flex; gap: 6px; flex-wrap: wrap; }
  .vocab-filter { border: 1px solid var(--line); background: var(--paper); color: var(--muted); border-radius: 999px; padding: 5px 12px; font-size: 12px; cursor: pointer; }
  .vocab-filter.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .vocab-count-chip { opacity: .65; font-variant-numeric: tabular-nums; }
  .vocab-controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .vocab-view { display: flex; gap: 6px; }
  .role-vocabulary.is-compact .word { padding: 12px 14px; gap: 5px; }
  .role-vocabulary.is-compact .word-context,
  .role-vocabulary.is-compact .note,
  .role-vocabulary.is-compact .sources { display: none; }
  .role-vocabulary.is-compact .def { font-size: 14px; }
  .role-vocabulary.is-compact .word-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .vocab-controls select, .vocab-controls input { font: inherit; padding: 7px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--ink); }
  .vocab-controls input { min-width: 220px; }
  .vocab-empty { color: var(--muted); padding: 24px 0; }
  .vocab-group { margin-top: 18px; }
  .vocab-group-head { display: flex; align-items: baseline; gap: 8px; margin: 0 0 8px; font-size: 17px; color: var(--ink); border-bottom: 1px solid var(--line); padding-bottom: 6px; }
  .vocab-more { margin: 18px auto 0; display: block; background: transparent; color: var(--accent); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; }
  .word-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 14px; }
  .word-audio { width: 40px; height: 40px; min-height: 40px; padding: 0; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .word-audio.is-playing { background: var(--gold); border-color: var(--gold); }
  .word.is-target { outline: 2px solid var(--accent); outline-offset: 2px; }
  .word-origin { font-size: 12px; color: var(--muted); text-decoration: none; }
  .word-origin:hover { color: var(--accent); }
  .word-context summary { cursor: pointer; color: var(--accent); font-size: 13px; }
  .chips-label { font-size: 12px; color: var(--muted); }
  .toc { display: flex; gap: 8px; overflow-x: auto; padding: 0 0 16px; scrollbar-width: thin; }
  .toc a { flex: 0 0 auto; min-height: 40px; display: inline-flex; align-items: center; font-size: 12px; color: var(--muted); text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 5px 10px; background: var(--paper); }
  .to-top { position: fixed; right: 18px; bottom: 18px; z-index: 20; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--line); color: var(--accent); text-decoration: none; box-shadow: 0 4px 14px rgba(33,31,27,.12); opacity: 0; pointer-events: none; transform: translateY(8px); transition: opacity .2s ease, transform .2s ease; }
  .to-top.is-visible { opacity: 1; pointer-events: auto; transform: none; }
  .player { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; background: rgba(255,253,249,.97); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgba(33,31,27,.08); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); }
  .player-inner { max-width: 980px; margin: 0 auto; display: flex; align-items: center; gap: 12px; }
  .player-toggle { width: 40px; height: 40px; padding: 0; border-radius: 50%; flex: 0 0 auto; }
  .player-main { flex: 1; min-width: 0; }
  .player-label { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px; }
  .player-seek { width: 100%; height: 20px; margin: 0; accent-color: var(--accent); }
  .player-time { flex: 0 0 auto; min-width: 96px; text-align: right; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  body.player-open { padding-bottom: 92px; }
  body.player-open .to-top { bottom: 96px; }
  @media (max-width: 1100px) { .word-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .word-grid { grid-template-columns: 1fr; }
    .vocab-toolbar { position: static; }
    .vocab-controls { width: 100%; }
    .vocab-controls select, .vocab-controls input { width: 100%; min-width: 0; }
    .vocab-filter { min-height: 44px; }
    .vocab-controls select, .vocab-controls input { min-height: 44px; }
    .word-audio { width: 44px; height: 44px; min-height: 44px; }
    .player-time { min-width: 78px; font-size: 11px; }
  }
  .word { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 8px; }
  .word-image { max-height: 160px; object-fit: cover; }
  .word-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 8px; }
  .word-title { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; min-width: 0; }
  .word-head h3 { margin: 0; }
  .ipa { font-size: 13px; color: var(--muted); }
  .pos { font-size: 12px; color: #8a6a2f; text-transform: uppercase; letter-spacing: .08em; }
  .def { margin: 0; }
  blockquote { margin: 0; padding: 10px 12px; background: #f3eee5; border-radius: 8px; font-size: 13px; color: #4a453d; }
  .note { margin: 0; font-size: 13px; color: var(--muted); }
  .badge { font-size: 11px; border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; color: var(--muted); }
  .badge-domain_term { background: #eef3ff; border-color: #c9d8f5; color: #2454a6; }
  .badge-proper_noun { background: #f3ecff; border-color: #dccbf3; color: #6a3d9a; }
  .badge-work_title { background: #fff1e6; border-color: #f0d3bb; color: #9a4f1c; }
  .badge-school_genre { background: #e9f7ef; border-color: #c6e7d4; color: #236b43; }
  .badge-common_advanced { background: #f3f1ec; border-color: #ddd5c8; color: #6d675d; }
  .sources { margin-top: auto; padding-top: 6px; font-size: 12px; }
  .sources summary { cursor: pointer; color: var(--muted); }
  .sources a { color: var(--accent); text-decoration: none; margin-right: 10px; }
  footer { border-top: 1px solid var(--line); margin-top: 40px; padding-top: 18px; font-size: 12px; color: var(--muted); }
  @media (max-width: 600px) {
    .wrap { padding: 0 16px 48px; }
    header.hero { padding-top: 36px; }
    .chapter { padding: 18px; }
    .group.layout-row { flex-direction: column; }
  }
</style>
</head>
<body>
{% macro render_block(block) -%}
  {%- if block.type == "text" -%}
    <p class="text text-{{ block.style.value }}">{{ block.text }}</p>
  {%- elif block.type == "image" -%}
    {%- set resource = resources.get(block.resource) -%}
    {%- if resource and resource.href not in missing -%}
      <figure><img src="{{ resource.href }}" alt="{{ block.alt or resource.alt or '' }}" loading="lazy"></figure>
    {%- else -%}
      <div class="missing">{{ block.alt or labels.missing_image }}</div>
    {%- endif -%}
  {%- elif block.type == "audio" -%}
    {# Audio is played by the section playlist; no per-block native player. #}
  {%- elif block.type == "word" -%}
    <article class="word" id="word-{{ block.id }}" data-category="{{ block.category or '' }}" data-section-id="{{ block.section_id }}" data-search="{{ block.term }} {{ block.definitions.values()|join(' ') }} {{ block.context or '' }}">
      {%- if block.image and resources.get(block.image) and resources[block.image].href not in missing -%}
        <img class="word-image" src="{{ resources[block.image].href }}" alt="">
      {%- endif -%}
      <div class="word-head">
        <div class="word-title">
          <h3>{{ block.term }}</h3>
          {%- if block.ipa %}<span class="ipa">{{ block.ipa }}</span>{% endif -%}
          {%- if block.audio and resources.get(block.audio) and resources[block.audio].href not in missing -%}
            <button class="word-audio" type="button" data-word-audio="{{ resources[block.audio].href }}" aria-label="{{ labels.word_audio_label }}" title="{{ labels.word_audio_label }}">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
            </button>
          {%- endif -%}
        </div>
        {%- if block.category %}<span class="badge badge-{{ block.category }}">{{ category_label(block, labels) }}</span>{% endif -%}
      </div>
      {%- if block.part_of_speech %}<p class="pos">{{ block.part_of_speech }}</p>{% endif -%}
      <p class="def">{{ definition(block, document.meta.language) }}</p>
      {%- if block.context -%}
        <details class="word-context"><summary>{{ labels.context_label }}</summary><blockquote>{{ block.context }}</blockquote></details>
      {%- endif -%}
      {%- if block.note %}<p class="note">{{ block.note }}</p>{% endif -%}
      <a class="word-origin" href="#{{ block.section_id }}">{{ labels.word_origin_prefix }} {{ section_titles.get(block.section_id, block.section_id) }}</a>
      {%- set sources = visible_sources(block) -%}
      {%- if sources -%}
        <details class="sources">
          <summary>{{ labels.sources_label }}</summary>
          {%- for source in sources -%}
            <a href="{{ source.url }}" rel="noopener noreferrer">{{ source.name }}</a>
          {%- endfor -%}
        </details>
      {%- endif -%}
    </article>
  {%- elif block.type == "group" -%}
    <div class="group layout-{{ block.layout.value if block.layout else 'stack' }}">
      {%- if block.script -%}
        <details class="script"><summary>{{ labels.expand_script }}</summary><p>{{ block.script }}</p></details>
      {%- endif -%}
      {%- for child in block.blocks -%}{{ render_block(child) }}{%- endfor -%}
    </div>
  {%- endif -%}
{%- endmacro %}
<div class="wrap" id="top">
  <header class="hero">
    <p class="eyebrow">{{ labels.report_eyebrow }}</p>
    <h1>{{ document.meta.title }}</h1>
    {%- if document.meta.subtitle %}<p class="subtitle">{{ document.meta.subtitle }}</p>{% endif -%}
    <p class="meta">
      {%- if duration_min is not none %}{{ duration_min }} 分钟 · {% endif -%}
      {{ document.sections | length }} {{ labels.section_unit }} ·
      {{ word_index | length }} 个词条
    </p>
    {%- if document.meta.description %}<p class="description">{{ document.meta.description }}</p>{% endif -%}
  </header>

  <nav class="toc" aria-label="{{ labels.toc_heading }}">
    {%- for section in document.sections -%}
      <a href="#{{ section.id }}">{{ section.title }}</a>
    {%- endfor -%}
  </nav>

  <main>
    <section class="narrative-intro">
      <h2>{{ labels.narrative_heading }}</h2>
      <p class="section-lead">{{ labels.narrative_lead }}</p>
    </section>
    {%- for section in document.sections -%}
      {%- if section.role.value == "vocabulary" -%}
        <section class="chapter role-vocabulary" id="{{ section.id }}">
          <div class="chapter-head">
            <h2>{{ section.title }}</h2>
            <span class="vocab-count" data-word-count aria-live="polite">{{ section.blocks | length }} 个词</span>
          </div>
          <div class="vocab-toolbar" role="region" aria-label="{{ labels.filter_category }}">
            <div class="vocab-categories" role="group" aria-label="{{ labels.filter_category }}">
              <button type="button" class="vocab-filter is-active" data-category-filter="all">{{ labels.filter_all }}</button>
              {%- for key in ["domain_term", "proper_noun", "work_title", "school_genre", "common_advanced"] -%}
                <button type="button" class="vocab-filter" data-category-filter="{{ key }}">{{ labels["category." ~ key] }} <span class="vocab-count-chip">{{ category_counts.get(key, 0) }}</span></button>
              {%- endfor -%}
            </div>
            <div class="vocab-controls">
              <div class="vocab-view" role="group" aria-label="{{ labels.view_label }}">
                <button type="button" class="vocab-filter is-active" data-density="cards">{{ labels.view_cards }}</button>
                <button type="button" class="vocab-filter" data-density="compact">{{ labels.view_compact }}</button>
              </div>
              <label class="visually-hidden" for="vocab-section-filter">{{ labels.filter_section }}</label>
              <select id="vocab-section-filter" data-section-filter aria-label="{{ labels.filter_section }}">
                <option value="all">{{ labels.filter_all_sections }}</option>
                {%- for narrative in document.sections if narrative.role.value == "narrative" -%}
                  <option value="{{ narrative.id }}">{{ narrative.title }} ({{ section_counts.get(narrative.id, 0) }})</option>
                {%- endfor -%}
              </select>
              <input type="search" data-word-search placeholder="{{ labels.search_words }}" aria-label="{{ labels.search_words }}">
            </div>
          </div>
          <p class="vocab-empty" data-word-empty hidden>{{ labels.no_words }}</p>
          {%- for group in group_words(section.blocks) -%}
            <section class="vocab-group" data-vocab-group="{{ group.key }}">
              <h3 class="vocab-group-head">
                <span>{{ labels["category." ~ group.key] if group.key != "other" else labels.other_category }}</span>
                <span class="vocab-count-chip" data-group-count>{{ group.blocks | length }}</span>
              </h3>
              <div class="word-grid">
                {%- for block in group.blocks -%}{{ render_block(block) }}{%- endfor -%}
              </div>
              <button class="vocab-more" type="button" data-group-more data-group-key="{{ group.key }}" data-more-label="{{ labels.show_more }}" hidden>{{ labels.show_more }}</button>
            </section>
          {%- endfor -%}
        </section>
      {%- else -%}
        <section class="chapter role-{{ section.role.value }}" id="{{ section.id }}">
          <div class="chapter-head">
            <h2>{{ section.title }}</h2>
            {%- if section.time -%}
              <span class="time">{{ format_ms(section.time.start_ms) }} – {{ format_ms(section.time.end_ms) }}</span>
            {%- endif -%}
            {%- set playlist = section_playlists.get(section.id, []) -%}
            {%- if playlist -%}
              <button class="play" type="button" data-playlist='{{ playlist | tojson }}' data-label="{{ section.title }}">{{ labels.play_section }}</button>
            {%- elif section_audio.get(section.id) -%}
              <span class="no-audio">{{ labels.no_audio }}</span>
            {%- endif -%}
          </div>
          {%- if section.keywords -%}
            <div class="chips">
              <span class="chips-label">{{ labels.key_terms_heading }}</span>
              {%- for keyword in section.keywords -%}
                {%- set word = word_index.get(keyword.word_id) -%}
                {%- if word %}<a class="chip" href="#word-{{ word.id }}">{{ word.term }}</a>{% endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- for block in section.blocks -%}{{ render_block(block) }}{%- endfor -%}
        </section>
      {%- endif -%}
    {%- endfor -%}
  </main>

  {%- if document.meta.attribution -%}
    <footer>{{ document.meta.attribution | join(" · ") }}</footer>
  {%- endif -%}
</div>
<a class="to-top" href="#top" aria-label="{{ labels.back_to_top }}" title="{{ labels.back_to_top }}">↑</a>
<div class="player" data-player hidden>
  <div class="player-inner">
    <button class="player-toggle" type="button" data-player-toggle aria-label="{{ labels.play_pause }}">▶</button>
    <div class="player-main">
      <div class="player-label" data-player-label></div>
      <input class="player-seek" data-player-seek type="range" min="0" max="1000" value="0" aria-label="{{ labels.progress_label }}">
      <div class="player-time" data-player-time>00:00 / 00:00</div>
    </div>
  </div>
</div>
<audio id="audio-player" preload="none"></audio>
<script>
(function () {
  var audioPlayer = document.getElementById("audio-player");
  var playerBar = document.querySelector("[data-player]");
  var playerToggle = document.querySelector("[data-player-toggle]");
  var playerLabel = document.querySelector("[data-player-label]");
  var playerSeek = document.querySelector("[data-player-seek]");
  var playerTime = document.querySelector("[data-player-time]");
  var wordButtons = Array.prototype.slice.call(document.querySelectorAll("[data-word-audio]"));
  var playlist = [];
  var playlistIndex = 0;

  function formatTime(value) {
    if (!isFinite(value) || value < 0) value = 0;
    var total = Math.floor(value);
    var minutes = Math.floor(total / 60);
    var seconds = total % 60;
    return minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
  }

  function updatePlayer() {
    if (!audioPlayer) return;
    var duration = audioPlayer.duration || 0;
    var current = audioPlayer.currentTime || 0;
    if (playerSeek) playerSeek.value = duration ? String(Math.round(current / duration * 1000)) : "0";
    if (playerTime) playerTime.textContent = formatTime(current) + " / " + formatTime(duration);
  }

  function setPlayerVisible(visible) {
    if (playerBar) playerBar.hidden = !visible;
    document.body.classList.toggle("player-open", visible);
  }

  function playCurrent() {
    if (!audioPlayer || playlistIndex >= playlist.length) return;
    audioPlayer.src = playlist[playlistIndex];
    audioPlayer.play().catch(function () {});
  }

  function playList(sources, label, withBar) {
    playlist = sources || [];
    playlistIndex = 0;
    if (!playlist.length) return;
    if (withBar) {
      if (playerLabel) playerLabel.textContent = label || "";
      setPlayerVisible(true);
    } else {
      setPlayerVisible(false);
    }
    playCurrent();
  }

  if (audioPlayer) {
    audioPlayer.addEventListener("timeupdate", updatePlayer);
    audioPlayer.addEventListener("loadedmetadata", updatePlayer);
    audioPlayer.addEventListener("play", function () {
      if (playerToggle) playerToggle.textContent = "❚❚";
    });
    audioPlayer.addEventListener("pause", function () {
      if (playerToggle) playerToggle.textContent = "▶";
    });
    audioPlayer.addEventListener("ended", function () {
      playlistIndex++;
      if (playlistIndex < playlist.length) {
        playCurrent();
        return;
      }
      if (playerToggle) playerToggle.textContent = "▶";
      wordButtons.forEach(function (item) { item.classList.remove("is-playing"); });
    });
  }
  if (playerToggle) {
    playerToggle.addEventListener("click", function () {
      if (!audioPlayer) return;
      if (audioPlayer.paused) audioPlayer.play().catch(function () {});
      else audioPlayer.pause();
    });
  }
  if (playerSeek) {
    playerSeek.addEventListener("input", function () {
      var duration = audioPlayer && audioPlayer.duration ? audioPlayer.duration : 0;
      if (duration && audioPlayer) {
        audioPlayer.currentTime = Number(playerSeek.value) / 1000 * duration;
      }
    });
  }

  document.querySelectorAll("[data-playlist]").forEach(function (button) {
    button.addEventListener("click", function () {
      var sources;
      try {
        sources = JSON.parse(button.getAttribute("data-playlist") || "[]");
      } catch (error) {
        return;
      }
      wordButtons.forEach(function (item) { item.classList.remove("is-playing"); });
      playList(sources, button.getAttribute("data-label") || "", true);
    });
  });

  wordButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      var src = button.getAttribute("data-word-audio");
      if (!src) return;
      wordButtons.forEach(function (item) { item.classList.remove("is-playing"); });
      button.classList.add("is-playing");
      playList([src], "", false);
    });
  });

  var vocabulary = document.querySelector(".role-vocabulary");
  if (!vocabulary) return;
  var cards = Array.prototype.slice.call(vocabulary.querySelectorAll(".word"));
  var groups = Array.prototype.slice.call(vocabulary.querySelectorAll("[data-vocab-group]"));
  var buttons = Array.prototype.slice.call(vocabulary.querySelectorAll("[data-category-filter]"));
  var sectionFilter = vocabulary.querySelector("[data-section-filter]");
  var search = vocabulary.querySelector("[data-word-search]");
  var count = vocabulary.querySelector("[data-word-count]");
  var empty = vocabulary.querySelector("[data-word-empty]");
  var category = "all";
  var isPhone = window.matchMedia("(max-width: 700px)").matches;
  var groupLimits = {};
  groups.forEach(function (group) {
    groupLimits[group.getAttribute("data-vocab-group")] = isPhone ? 6 : Infinity;
  });

  var densityButtons = Array.prototype.slice.call(vocabulary.querySelectorAll("[data-density]"));
  var density = "cards";
  try {
    density = localStorage.getItem("situlearn-vocab-density") || "cards";
  } catch (error) {}
  function applyDensity() {
    vocabulary.classList.toggle("is-compact", density === "compact");
    densityButtons.forEach(function (button) {
      button.classList.toggle("is-active", button.getAttribute("data-density") === density);
    });
  }
  densityButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      density = button.getAttribute("data-density");
      try {
        localStorage.setItem("situlearn-vocab-density", density);
      } catch (error) {}
      applyDensity();
    });
  });
  applyDensity();

  function applyWordFilters() {
    var query = (search && search.value ? search.value : "").trim().toLowerCase();
    var section = sectionFilter ? sectionFilter.value : "all";
    var totalMatches = 0;
    var visibleTotal = 0;

    groups.forEach(function (group) {
      var key = group.getAttribute("data-vocab-group");
      var groupCards = Array.prototype.slice.call(group.querySelectorAll(".word"));
      var matching = groupCards.filter(function (card) {
        var matchCategory = category === "all" || card.getAttribute("data-category") === category;
        var matchSection = section === "all" || card.getAttribute("data-section-id") === section;
        var haystack = (card.getAttribute("data-search") || "").toLowerCase();
        var matchQuery = !query || haystack.indexOf(query) !== -1;
        return matchCategory && matchSection && matchQuery;
      });
      var limit = groupLimits[key] === undefined ? Infinity : groupLimits[key];
      groupCards.forEach(function (card) {
        var index = matching.indexOf(card);
        card.hidden = index === -1 || index >= limit;
      });
      var visible = Math.min(matching.length, limit);
      group.hidden = matching.length === 0;
      var groupCount = group.querySelector("[data-group-count]");
      if (groupCount) {
        groupCount.textContent = visible === matching.length
          ? String(matching.length)
          : visible + " / " + matching.length;
      }
      var more = group.querySelector("[data-group-more]");
      if (more) {
        more.hidden = matching.length <= limit;
        more.textContent = (more.getAttribute("data-more-label") || "显示更多") +
          " (" + Math.max(0, matching.length - limit) + ")";
      }
      totalMatches += matching.length;
      visibleTotal += visible;
    });

    buttons.forEach(function (button) {
      button.classList.toggle("is-active", button.getAttribute("data-category-filter") === category);
    });
    if (count) count.textContent = visibleTotal + " / " + cards.length + " 个词";
    if (empty) empty.hidden = totalMatches !== 0;
  }

  buttons.forEach(function (button) {
    button.addEventListener("click", function () {
      category = button.getAttribute("data-category-filter");
      applyWordFilters();
    });
  });
  if (sectionFilter) sectionFilter.addEventListener("change", applyWordFilters);
  if (search) search.addEventListener("input", applyWordFilters);
  groups.forEach(function (group) {
    var key = group.getAttribute("data-vocab-group");
    var more = group.querySelector("[data-group-more]");
    if (more) {
      more.addEventListener("click", function () {
        groupLimits[key] = (groupLimits[key] || 0) + 6;
        applyWordFilters();
      });
    }
  });

  document.querySelectorAll('.chip[href^="#word-"]').forEach(function (link) {
    link.addEventListener("click", function (event) {
      var targetId = link.getAttribute("href").slice(1);
      var card = document.getElementById(targetId);
      if (!card) return;
      event.preventDefault();
      category = "all";
      if (sectionFilter) sectionFilter.value = "all";
      if (search) search.value = "";
      var group = card.closest("[data-vocab-group]");
      if (group) {
        var key = group.getAttribute("data-vocab-group");
        var groupCards = Array.prototype.slice.call(group.querySelectorAll(".word"));
        groupLimits[key] = Math.max(
          groupLimits[key] || 0,
          groupCards.indexOf(card) + 1
        );
      }
      applyWordFilters();
      card.hidden = false;
      card.scrollIntoView({ behavior: "smooth", block: "center" });
      card.setAttribute("tabindex", "-1");
      card.focus({ preventScroll: true });
      card.classList.add("is-target");
      window.setTimeout(function () { card.classList.remove("is-target"); }, 1600);
    });
  });

  var toTop = document.querySelector(".to-top");
  function updateToTop() {
    if (toTop) toTop.classList.toggle("is-visible", window.scrollY > 600);
  }
  window.addEventListener("scroll", updateToTop, { passive: true });
  updateToTop();

  applyWordFilters();
})();
</script>
</body>
</html>
